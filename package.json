{
  "name": "openassistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A minimal desktop assistant overlay built with Tauri and vanilla JavaScript.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "@shikijs/core": "4.6.0",
    "@shikijs/engine-javascript": "4.6.0",
    "@shikijs/langs": "4.6.0",
    "@shikijs/themes": "4.6.0",
    "@tauri-apps/api": "2.12.5",
    "@tauri-apps/plugin-store": "2.5.1",
    "dompurify": "3.4.18",
    "marked": "18.2.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tauri-apps/cli": "2.12.6",
    "jsdom": "31.0.1",
    "vite": "8.3.8"
  }
}
